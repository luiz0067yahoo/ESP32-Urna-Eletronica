# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - URNA ELETRÔNICA POKÉMON
# Arquivo central de variáveis de ambiente para Backend, Docker, Podman e K8s
# Copie este arquivo para .env na raiz do projeto:
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
# ==============================================================================

# Configurações do Banco de Dados MySQL / MariaDB
DB_HOST=db
DB_PORT=3306
DB_NAME=urna
DB_USER=urna
DB_PASS=urna123
MYSQL_ROOT_PASSWORD=rootpassword

# Portas dos Serviços Web (Docker e Podman)
APP_PORT=8080
PMA_PORT=8081
