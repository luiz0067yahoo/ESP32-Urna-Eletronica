# ==============================================================================
# Configuração Apache: Redirecionamento e entrega do Frontend via .htaccess
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Ignora regras de reescrita para backend, banco de dados e testes
    RewriteRule ^backend/ - [L]
    RewriteRule ^db/ - [L]
    RewriteRule ^tests/ - [L]

    # 2. Redireciona a raiz para o index.html do frontend
    RewriteRule ^$ frontend/index.html [L]
    RewriteRule ^index\.(html|php)$ frontend/index.html [L]

    # 3. Rota amigável para a tela de apuração (apuracao, apuracao.php, apuracao.html)
    RewriteRule ^apuracao(\.php|\.html)?$ frontend/apuracao.html [L]

    # 4. Não reescreve caso a requisição já tenha como destino a pasta frontend
    RewriteRule ^frontend/ - [L]

    # 5. Caso o recurso solicitado exista dentro da pasta frontend/, entrega-o
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/frontend/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/frontend/$1 -d
    RewriteRule ^(.*)$ frontend/$1 [L]
</IfModule>

# Define a página inicial padrão apontando diretamente para o frontend
DirectoryIndex frontend/index.html index.html

# Bloqueia acesso direto a arquivos sensíveis de ambiente
<FilesMatch "^\.(env|git)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
